#!/bin/bash

# omarchy:summary=Match against the computer's DMI product name or product family (case-insensitive).
# omarchy:args=<pattern>

dmi_dir=${OMARCHY_DMI_DIR:-/sys/class/dmi/id}

grep -qi -- "$1" "$dmi_dir/product_name" 2>/dev/null ||
grep -qi -- "$1" "$dmi_dir/product_family" 2>/dev/null ||
grep -qi -- "$1" "$dmi_dir/board_name" 2>/dev/null
