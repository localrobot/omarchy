#!/bin/bash

# omarchy:summary=Launch the default browser
# omarchy:args=[url]

browser_exec="google-chrome-stable"
omarchy-cmd-present "$browser_exec" || browser_exec="google-chrome"

private_flag=""
if [[ " $* " == *" --private "* ]]; then
  private_flag="--incognito"
fi

if [[ -n $private_flag ]]; then
  args=("${@/--private/$private_flag}")
else
  args=("$@")
fi

if ! omarchy-cmd-browser-handoff "$browser_exec" "${args[@]}"; then
  systemd-run --user --quiet --collect --unit="omarchy-browser-$(date +%s%N)" \
    --property=StandardOutput=null --property=StandardError=null \
    uwsm-app -- "$browser_exec" "${args[@]}"
fi

url=""
for argument in "$@"; do
  if [[ $argument != "--private" ]]; then
    url=$argument
    break
  fi
done

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  omarchy-hyprland-focus-app "^google-chrome.*$" || true
fi
