#!/bin/bash

# omarchy:summary=Remove a development environment that was previously installed via omarchy-install-dev-env.
# omarchy:args=<ruby|node|bun|deno|go|python|zig|rust|java>

if [[ -z $1 ]]; then
  echo "Usage: omarchy-remove-dev-env <ruby|node|bun|deno|go|python|zig|rust|java>" >&2
  exit 1
fi

case "$1" in
ruby)
  echo -e "Removing Ruby...\n"
  mise uninstall ruby --all
  mise rm -g ruby
  rm -f ~/.gemrc
  ;;
node)
  echo -e "Removing Node.js...\n"
  mise uninstall node --all
  mise rm -g node
  ;;
bun)
  echo -e "Removing Bun...\n"
  mise uninstall bun --all
  mise rm -g bun
  ;;
deno)
  echo -e "Removing Deno...\n"
  mise uninstall deno --all
  mise rm -g deno
  ;;
go)
  echo -e "Removing Go...\n"
  mise uninstall go --all
  mise rm -g go
  ;;
python)
  echo -e "Removing Python...\n"
  mise uninstall python --all
  mise rm -g python
  ;;
zig)
  echo -e "Removing Zig...\n"
  mise uninstall zig --all
  mise uninstall zls --all
  mise rm -g zig
  mise rm -g zls
  ;;
rust)
  echo -e "Removing Rust...\n"
  # Call rustup by path: ~/.cargo/bin may be off PATH, and mise links the
  # rustup toolchain as its own rust install with shims that shadow rustup.
  if ! "$HOME/.cargo/bin/rustup" self uninstall -y; then
    echo "Failed to remove Rust." >&2
    exit 1
  fi

  rm -rf "$HOME/.local/share/mise/installs/rust"
  mise reshim
  ;;
java)
  echo -e "Removing Java...\n"
  mise uninstall java --all
  mise rm -g java
  ;;
*)
  echo "Unknown environment: $1"
  exit 1
  ;;
esac

echo -e "\nDone!"
