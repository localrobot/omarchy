#!/bin/bash

# omarchy:summary=Default browser for Omarchy and XDG handlers
# omarchy:hidden=true

installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

if (($# == 0)); then
  echo "chrome"
  exit 0
fi

if [[ $1 != "chrome" && $1 != "google-chrome" ]]; then
  echo "Google Chrome is the only supported browser."
  exit 1
fi

command="google-chrome-stable"
omarchy-cmd-present "$command" || command="google-chrome"

if omarchy-cmd-missing "$command"; then
  if [[ $installing == "false" ]]; then
    exec omarchy-launch-floating-terminal-with-presentation omarchy-default-browser --install chrome
  else
    omarchy-install-browser chrome || exit 1
  fi
fi

env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser google-chrome.desktop || true
echo "chrome"
