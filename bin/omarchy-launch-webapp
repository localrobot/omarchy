#!/bin/bash

# omarchy:summary=Launch a URL as a web app in Google Chrome
# omarchy:args=<url>

browser_exec="google-chrome-stable"
omarchy-cmd-present "$browser_exec" || browser_exec="google-chrome"

if ! omarchy-cmd-browser-handoff "$browser_exec" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- $browser_exec --app="$1" "${@:2}"
fi
