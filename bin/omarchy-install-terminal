#!/bin/bash

# omarchy:summary=Install foot terminal and set it as the default for Omarchy (Super + Return etc).
# omarchy:args=[foot]
# omarchy:requires-sudo=true

if (($# == 0)); then
  package="foot"
else
  package="$1"
fi

if [[ $package != "foot" ]]; then
  echo "Usage: omarchy-install-terminal [foot]"
  exit 1
fi

desktop_id="foot.desktop"
echo "Installing foot..."

# Install package
if omarchy-pkg-add foot; then
  # Copy custom desktop entries with X-TerminalArg* keys
  mkdir -p ~/.local/share/applications
  cp "$OMARCHY_PATH/applications/$desktop_id" ~/.local/share/applications/

  # Copy default config for foot when missing
  if [[ ! -e ~/.config/foot ]]; then
    cp -Rpf "$OMARCHY_PATH/config/foot" ~/.config/
  fi

  # Update xdg-terminals.list to prioritize foot
  cat >~/.config/xdg-terminals.list <<EOF
# Terminal emulator preference order for xdg-terminal-exec
# The first found and valid terminal will be used
$desktop_id
EOF
else
  echo "Failed to install foot"
  exit 1
fi
